# Gmail MCP server configuration (amazing-gmail-mcp). Placeholders only.
# Copy to .env and fill in. NEVER commit .env, and never paste the token into a chat.
#
# One entry = one mailbox: each process serves exactly the account below, and its token
# must belong to it (the server checks users/me/profile before the first API call).

# The mailbox this process serves. Required.
GMAIL_ACCOUNT=you@example.com

# The gmail.readonly refresh token, minted ONCE per company with amazing-gmail-mcp-login
# (from a Mac) and kept in a secret manager. Required. A token granted more than
# gmail.readonly (gmail.modify, gmail.compose, https://mail.google.com/) is refused.
GMAIL_REFRESH_TOKEN=

# The OAuth client the token was minted with: a "Desktop app" client of an Internal Google
# Cloud project. Either the JSON file Google lets you download (it has an "installed" key)...
GMAIL_CLIENT_SECRET_FILE=/path/to/client_secret.json
# ...or the same two values inline (set these OR the file, never both).
# GMAIL_CLIENT_ID=<client id>.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=<client secret>

# Optional project scope: a filter on what the tools show, NOT a security boundary.
# A label name or id; every search is limited to it, and every fetch is re-checked.
# GMAIL_SCOPE_LABEL=Projects/Acme
# A Gmail query ANDed with every search, as (<scope>) (<your query>).
# GMAIL_SCOPE_QUERY=from:example.com

# Output bounds.
# GMAIL_BODY_MAX_CHARS=20000
# GMAIL_ATTACHMENT_DIR=~/Downloads/gmail-mcp
# GMAIL_ATTACHMENT_MAX_BYTES=26214400
